{
  "name": "quan-ly-day-tro",
  "version": "1.0.0",
  "description": "Hệ thống Quản lý Dãy trọ - Kiến trúc Modular Monolith & Monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/backend\" \"npm run dev --workspace=apps/frontend\"",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "start:backend": "npm run start --workspace=apps/backend",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "quan-ly-day-tro",
    "monorepo",
    "modular-monolith",
    "postgresql",
    "express"
  ],
  "author": "",
  "license": "ISC"
}
